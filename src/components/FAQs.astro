---
import { faqs } from "../data/faqs";
---

<section id="faqs" class="border-t border-charcoal-800/10 bg-charcoal-950 py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <div class="reveal text-center">
      <span class="text-xs font-semibold uppercase tracking-wide text-yellow-500">FAQs</span>
      <h2 class="mt-3 font-display text-3xl font-semibold text-white sm:text-4xl">Common questions</h2>
    </div>

    <div class="mt-10 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-charcoal-900">
      {faqs.map((faq) => (
        <details class="group reveal px-6 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-medium text-white marker:content-none">
            {faq.question}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0 text-yellow-500 transition-transform group-open:rotate-45" aria-hidden="true">
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-charcoal-400">{faq.answer}</p>
        </details>
      ))}
    </div>

    <div class="reveal mt-10 text-center">
      <p class="text-sm text-charcoal-400">Still have a question?</p>
      <a href="#contact" class="mt-2 inline-flex items-center justify-center rounded-full bg-yellow-500 px-7 py-3 text-sm font-semibold text-charcoal-950 shadow-sm shadow-yellow-500/20 transition-transform hover:-translate-y-0.5 hover:bg-yellow-400">
        Ask Leroy Directly
      </a>
    </div>
  </div>
</section>
