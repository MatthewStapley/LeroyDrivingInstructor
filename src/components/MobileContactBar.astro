---
import { site } from "../data/site";
---

<div
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-3 border-t border-charcoal-800/10 bg-charcoal-950/95 backdrop-blur lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={site.phoneHref}
    class="flex flex-col items-center justify-center gap-1 py-3 text-white active:bg-charcoal-800"
    aria-label={`Call ${site.name}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
      <path d="M4.5 4h3.4l1.6 4.5-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4.5 1.6v3.4a2 2 0 0 1-2.2 2A17 17 0 0 1 2.5 6.2 2 2 0 0 1 4.5 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
    <span class="text-[11px] font-semibold">Call</span>
  </a>

  <a
    href={site.whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center justify-center gap-1 border-x border-charcoal-800 py-3 text-white active:bg-charcoal-800"
    aria-label="Message on WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
      <path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M8.5 8.8c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .6.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.2-.1.3 0 .5.4.7 1.4 1.7 2.1 2.1.2.1.3.1.5 0l.6-.5c.2-.1.4-.2.6-.1l1.6.7c.4.2.4.4.4.6v.5c0 .3 0 .6-.5.8-1 .4-2.5.1-4.3-1.5-1.5-1.3-2.4-2.8-2.6-3.9-.1-.6 0-1.2.1-1.4Z" fill="currentColor"/>
    </svg>
    <span class="text-[11px] font-semibold">WhatsApp</span>
  </a>

  <a
    href="#contact"
    class="flex flex-col items-center justify-center gap-1 bg-yellow-500 py-3 text-charcoal-950 active:bg-yellow-400"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
      <path d="M4 5h16v10H9l-4 3.5V15H4V5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
    <span class="text-[11px] font-semibold">Enquire</span>
  </a>
</div>
