---
// A clearly-labelled, on-brand placeholder used anywhere a real photo isn't
// available yet. Deliberately looks intentional rather than like a broken
// image or generic stock/clip-art.
interface Props {
  label: string;
  ratio?: "square" | "portrait" | "landscape" | "wide";
  class?: string;
}

const { label, ratio = "landscape", class: className = "" } = Astro.props;

const ratioClass = {
  square: "aspect-square",
  portrait: "aspect-[3/4]",
  landscape: "aspect-[4/3]",
  wide: "aspect-[16/9]",
}[ratio];
---

<div
  class:list={[
    "relative overflow-hidden rounded-2xl bg-charcoal-800",
    ratioClass,
    className,
  ]}
>
  <svg class="absolute inset-0 h-full w-full text-charcoal-700" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <pattern id="diagonal" width="16" height="16" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="16" stroke="currentColor" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#diagonal)" />
  </svg>
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-4 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-8 w-8 text-yellow-500/80" aria-hidden="true">
      <path d="M4 16.5 8.5 11l3 3L16 9l4 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="8" cy="8.5" r="1.4" fill="currentColor"/>
    </svg>
    <span class="rounded-full bg-charcoal-900/80 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-yellow-400">
      Placeholder image
    </span>
    <span class="max-w-[16ch] text-xs text-charcoal-300">{label}</span>
  </div>
</div>
