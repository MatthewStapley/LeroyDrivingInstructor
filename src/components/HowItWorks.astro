---
import { howItWorks } from "../data/content";
---

<section class="bg-charcoal-950 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wide text-yellow-500">How It Works</span>
      <h2 class="mt-3 font-display text-3xl font-semibold text-white sm:text-4xl">From first lesson to pass</h2>
    </div>

    <div class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      <div class="pointer-events-none absolute inset-x-0 top-6 hidden h-px bg-white/10 lg:block" aria-hidden="true"></div>
      {howItWorks.map((step, i) => (
        <div class="reveal relative" style={`animation-delay: ${i * 100}ms`}>
          <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-500 font-display text-lg font-bold text-charcoal-950">
            {i + 1}
          </div>
          <h3 class="mt-5 font-display text-lg font-semibold text-white">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-400">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
