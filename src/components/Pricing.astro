---
import { pricePlans } from "../data/pricing";
---

<section id="prices" class="border-y border-charcoal-800/10 bg-charcoal-950 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="reveal flex flex-col items-center gap-4 text-center">
      <span class="text-xs font-semibold uppercase tracking-wide text-yellow-500">Lesson Prices</span>
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Simple, honest pricing</h2>
      <p class="max-w-xl text-charcoal-400">No hidden fees — just straightforward rates with real savings the more you book.</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {pricePlans.map((plan, i) => (
        <div
          class:list={[
            "reveal relative flex flex-col rounded-2xl border p-7 transition-colors duration-300",
            plan.highlighted
              ? "border-yellow-500 bg-charcoal-900 shadow-xl shadow-yellow-500/10 sm:-translate-y-3"
              : "border-white/10 bg-charcoal-900/60 hover:border-white/25",
          ]}
          style={`animation-delay: ${i * 90}ms`}
        >
          <h3 class="font-display text-lg font-semibold text-white">{plan.label}</h3>
          <p class="mt-4 flex items-baseline gap-1">
            <span class="font-display text-4xl font-semibold text-white">{plan.price}</span>
            {plan.perUnit && <span class="text-sm text-charcoal-400">{plan.perUnit}</span>}
          </p>
          {plan.savings && (
            <span class="mt-2 inline-flex w-fit rounded-full bg-yellow-500/10 px-2.5 py-1 text-xs font-semibold text-yellow-400">
              {plan.savings}
            </span>
          )}
          <p class="mt-4 flex-1 text-sm leading-relaxed text-charcoal-400">{plan.description}</p>
          <a
            href="#contact"
            class:list={[
              "mt-6 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-transform hover:-translate-y-0.5",
              plan.highlighted
                ? "bg-yellow-500 text-charcoal-950 shadow-sm shadow-yellow-500/30 hover:bg-yellow-400"
                : "border border-white/20 text-white hover:border-white/40",
            ]}
          >
            Check Availability
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
