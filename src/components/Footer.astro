---
import { site, google } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="bg-charcoal-950 pb-28 pt-12 text-charcoal-400 lg:pb-12">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-6 border-t border-white/10 pt-8 sm:flex-row">
      <p class="font-display text-sm font-semibold text-white">
        Leroy <span class="text-yellow-500">Driving Instructor</span>
      </p>
      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs" aria-label="Footer">
        <a href={site.phoneHref} class="hover:text-white">{site.phone}</a>
        <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="hover:text-white">WhatsApp</a>
        <a href={google.writeReviewUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white">Leave a Review</a>
      </nav>
      <div class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1 text-center text-xs text-charcoal-500">
        <p>&copy; {year} Leroy Driving Instructor. All rights reserved.</p>
        <span class="hidden sm:inline" aria-hidden="true">&middot;</span>
        <p class="w-full sm:w-auto">
          Website by <a href="https://stapled.co.uk/" target="_blank" rel="noopener noreferrer" aria-label="Stapled. (opens in a new tab)" class="underline decoration-charcoal-500/50 underline-offset-2 transition-colors hover:text-white">Stapled.</a>
        </p>
      </div>
    </div>
  </div>
</footer>
