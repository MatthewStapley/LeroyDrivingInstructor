---
import PlaceholderImage from "./PlaceholderImage.astro";
import { realPupils, placeholderPupilSlots } from "../data/pupils";
---

<section id="pupils" class="bg-paper py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="reveal flex flex-col items-center gap-3 text-center">
      <span class="text-xs font-semibold uppercase tracking-wide text-yellow-600">Passed Pupils</span>
      <h2 class="font-display text-2xl font-semibold text-charcoal-950 sm:text-3xl">
        Every pass is the reason we do this
      </h2>
    </div>

    <div class="reveal relative mt-8">
      <button
        type="button"
        data-carousel-prev
        aria-label="Show previous pupils"
        class="absolute -left-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-charcoal-800/10 bg-white text-charcoal-800 shadow-md transition-colors hover:bg-charcoal-950 hover:text-white lg:flex"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        data-carousel-next
        aria-label="Show more pupils"
        class="absolute -right-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-charcoal-800/10 bg-white text-charcoal-800 shadow-md transition-colors hover:bg-charcoal-950 hover:text-white lg:flex"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        data-carousel
        tabindex="0"
        role="region"
        aria-label="Passed pupils gallery, scroll to see more"
        class="carousel-track -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pb-2 sm:mx-0 sm:px-0"
      >
        {realPupils.map((pupil, i) => (
          <div
            data-carousel-item
            class="reveal group w-[62%] shrink-0 snap-start sm:w-[38%] lg:w-[23%]"
            style={`animation-delay: ${i * 60}ms`}
          >
            <div class="relative aspect-square overflow-hidden rounded-2xl">
              {pupil.image ? (
                <img
                  src={pupil.image}
                  alt="Pupil who passed with Leroy"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <PlaceholderImage
                  label="Photo pending"
                  ratio="square"
                  class="transition-transform duration-500 group-hover:scale-105"
                />
              )}
              <span class="absolute left-2 top-2 rounded-full bg-yellow-500 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-charcoal-950 shadow-sm">
                {pupil.badge}
              </span>
            </div>
          </div>
        ))}

        {Array.from({ length: placeholderPupilSlots }).map((_, i) => (
          <div
            data-carousel-item
            class="w-[62%] shrink-0 snap-start sm:w-[38%] lg:w-[23%]"
          >
            <div class="flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-charcoal-800/15 bg-transparent p-4 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-7 w-7 text-charcoal-400" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <p class="text-xs font-medium text-charcoal-500">More passes coming soon</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .carousel-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
</style>
