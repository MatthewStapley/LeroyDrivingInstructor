---
import { site } from "../data/site";
---

<section id="contact" class="bg-paper py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="reveal overflow-hidden rounded-[2rem] bg-charcoal-950">
      <div class="grid gap-0 lg:grid-cols-2">
        <div class="p-8 sm:p-12">
          <span class="text-xs font-semibold uppercase tracking-wide text-yellow-500">Get In Touch</span>
          <h2 class="mt-3 font-display text-3xl font-semibold text-white sm:text-4xl">
            Let's get you on the road
          </h2>
          <p class="mt-4 text-charcoal-400">
            Message, call or WhatsApp Leroy directly to discuss your first lesson.
          </p>

          <div class="mt-8 space-y-4">
            <a href={site.phoneHref} class="flex items-center gap-4 rounded-xl border border-white/10 bg-charcoal-900 p-4 transition-colors hover:border-yellow-500/40">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-yellow-500/10 text-yellow-500">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
                  <path d="M4.5 4h3.4l1.6 4.5-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4.5 1.6v3.4a2 2 0 0 1-2.2 2A17 17 0 0 1 2.5 6.2 2 2 0 0 1 4.5 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>
                <span class="block text-xs text-charcoal-400">Call</span>
                <span class="block text-sm font-semibold text-white">{site.phone}</span>
              </span>
            </a>

            <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-xl border border-white/10 bg-charcoal-900 p-4 transition-colors hover:border-yellow-500/40">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-yellow-500/10 text-yellow-500">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
                  <path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>
                <span class="block text-xs text-charcoal-400">WhatsApp</span>
                <span class="block text-sm font-semibold text-white">Message Leroy</span>
              </span>
            </a>

            <div class="flex items-center gap-4 rounded-xl border border-white/10 bg-charcoal-900 p-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-yellow-500/10 text-yellow-500">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
                  <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6"/>
                </svg>
              </span>
              <span>
                <span class="block text-xs text-charcoal-400">Service Area</span>
                <span class="block text-sm font-semibold text-white">{site.serviceArea}</span>
              </span>
            </div>
          </div>
        </div>

        <div class="border-t border-white/10 bg-charcoal-900 p-8 sm:p-12 lg:border-l lg:border-t-0">
          <h3 class="font-display text-xl font-semibold text-white">Send a quick enquiry</h3>
          <p class="mt-2 text-sm text-charcoal-400">
            Prefer to send a message instead? Fill this in and Leroy will get back to you.
          </p>

          <!--
            No form backend — matching the old site, this just opens
            WhatsApp with a pre-filled message addressed to Leroy. See the
            inline script below for the wa.me handoff.
          -->
          <form id="enquiry-form" class="mt-6 space-y-4">
            <div>
              <label for="name" class="mb-1.5 block text-xs font-medium text-charcoal-300">Name</label>
              <input id="name" name="name" type="text" required class="w-full rounded-lg border border-white/15 bg-charcoal-950 px-4 py-2.5 text-sm text-white placeholder:text-charcoal-500 focus:border-yellow-500 focus:outline-none" placeholder="Your name" />
            </div>
            <div>
              <label for="phone" class="mb-1.5 block text-xs font-medium text-charcoal-300">Phone</label>
              <input id="phone" name="phone" type="tel" required class="w-full rounded-lg border border-white/15 bg-charcoal-950 px-4 py-2.5 text-sm text-white placeholder:text-charcoal-500 focus:border-yellow-500 focus:outline-none" placeholder="07..." />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-xs font-medium text-charcoal-300">Message</label>
              <textarea id="message" name="message" rows="3" class="w-full resize-none rounded-lg border border-white/15 bg-charcoal-950 px-4 py-2.5 text-sm text-white placeholder:text-charcoal-500 focus:border-yellow-500 focus:outline-none" placeholder="Tell Leroy a bit about your experience so far..."></textarea>
            </div>
            <button type="submit" class="w-full rounded-full bg-yellow-500 px-6 py-3.5 text-sm font-semibold text-charcoal-950 shadow-sm shadow-yellow-500/20 transition-transform hover:-translate-y-0.5 hover:bg-yellow-400">
              Send Enquiry
            </button>
          </form>

          <script define:vars={{ whatsappHref: site.whatsappHref }}>
            document.getElementById("enquiry-form")?.addEventListener("submit", (event) => {
              event.preventDefault();
              const form = event.currentTarget;
              const name = form.name.value.trim();
              const phone = form.phone.value.trim();
              const message = form.message.value.trim();

              const bodyLines = [
                `Website Enquiry from ${name}`,
                `Phone: ${phone}`,
                "",
                message,
              ];

              const url = `${whatsappHref}?text=${encodeURIComponent(bodyLines.join("\n"))}`;
              window.open(url, "_blank", "noopener,noreferrer");
            });
          </script>
        </div>
      </div>
    </div>
  </div>
</section>
