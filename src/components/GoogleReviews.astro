---
import { google } from "../data/site";
import { reviews } from "../data/reviews";

const fullStars = Math.round(google.rating);
---

<section id="reviews" class="border-b border-charcoal-800/10 bg-paper py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="reveal flex flex-col items-center gap-4 text-center">
      <div class="flex flex-wrap items-center justify-center gap-4 rounded-2xl border border-charcoal-800/10 bg-white px-6 py-4 shadow-sm">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="h-7 w-7 shrink-0" aria-hidden="true">
            <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.6H24v9h11.8c-.5 2.8-2 5.1-4.4 6.7v5.6h7.1c4.1-3.8 6.6-9.4 6.6-16.7Z"/>
            <path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.6c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.5-3.8-12.2-9H4.5v5.7C8.1 41 15.4 46 24 46Z"/>
            <path fill="#FBBC05" d="M11.8 28.2c-.4-1.3-.7-2.7-.7-4.2s.3-2.9.7-4.2v-5.7H4.5A22 22 0 0 0 2 24c0 3.5.8 6.9 2.5 9.9l7.3-5.7Z"/>
            <path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.3 3.3l6.3-6.3C34.9 4.2 29.9 2 24 2 15.4 2 8.1 7 4.5 14.1l7.3 5.7c1.7-5.2 6.5-9 12.2-9Z"/>
          </svg>
          <p class="text-sm font-semibold text-charcoal-950">
            {google.rating.toFixed(1)}
            <span class="text-yellow-500" aria-hidden="true">
              {"★".repeat(fullStars)}<span class="text-charcoal-200">{"★".repeat(5 - fullStars)}</span>
            </span>
            {" "}<span class="text-charcoal-600">based on {google.reviewCount} Google reviews</span>
          </p>
        </div>
        <div class="hidden h-6 w-px bg-charcoal-800/15 sm:block" aria-hidden="true"></div>
        <a
          href={google.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-charcoal-800 underline decoration-charcoal-300 underline-offset-2 hover:text-charcoal-950"
        >
          Read Reviews
        </a>
      </div>

      <a
        href={google.writeReviewUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-yellow-500 px-7 py-3 text-sm font-semibold text-charcoal-950 shadow-sm shadow-yellow-500/30 transition-transform hover:-translate-y-0.5 hover:bg-yellow-400"
      >
        Leave a Review
      </a>

      <p class="text-xs text-charcoal-500">
        Already learned with Leroy?{" "}
        <a href={google.writeReviewUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-charcoal-700 underline decoration-charcoal-300 underline-offset-2 hover:text-charcoal-950">
          Share your experience on Google.
        </a>
      </p>
    </div>

    <div class="reveal relative mt-10">
      <button
        type="button"
        data-carousel-prev
        aria-label="Show previous reviews"
        class="absolute -left-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-charcoal-800/10 bg-white text-charcoal-800 shadow-md transition-colors hover:bg-charcoal-950 hover:text-white lg:flex"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        data-carousel-next
        aria-label="Show more reviews"
        class="absolute -right-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-charcoal-800/10 bg-white text-charcoal-800 shadow-md transition-colors hover:bg-charcoal-950 hover:text-white lg:flex"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        data-carousel
        tabindex="0"
        role="region"
        aria-label="Pupil reviews, scroll to see more"
        class="carousel-track -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pb-2 sm:mx-0 sm:px-0"
      >
        {reviews.map((review, i) => {
          const firstName = review.reviewerName.split(" ")[0];
          return (
            <div
              data-carousel-item
              class="reveal flex w-[86%] shrink-0 snap-start flex-col rounded-2xl border border-charcoal-800/10 bg-white p-5 shadow-sm sm:w-[47%] lg:w-[31%]"
              style={`animation-delay: ${Math.min(i, 6) * 70}ms`}
            >
              <div class="flex items-center gap-3">
                {review.image ? (
                  <img
                    src={review.image}
                    alt={`${review.isAuthorPlaceholder ? "Former pupil" : firstName}, a pupil who passed with Leroy`}
                    width="96"
                    height="96"
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-12 shrink-0 rounded-full object-cover"
                  />
                ) : (
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-charcoal-950 text-sm font-semibold text-yellow-400" aria-hidden="true">
                    {review.initials}
                  </div>
                )}
                <div>
                  <p class="text-sm font-semibold text-charcoal-950">{review.reviewerName}</p>
                  <div class="flex items-center gap-0.5 text-yellow-500" aria-label="5 out of 5 stars">
                    {Array.from({ length: 5 }).map(() => (
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
                        <path d="M10 1.5l2.6 5.5 6 .7-4.4 4.1 1.2 6-5.4-3-5.4 3 1.2-6L1.4 7.7l6-.7L10 1.5Z"/>
                      </svg>
                    ))}
                  </div>
                </div>
              </div>
              <p class="mt-4 line-clamp-5 flex-1 text-sm leading-relaxed text-charcoal-700">&ldquo;{review.quote}&rdquo;</p>
              {review.googleUrl && (
                <a
                  href={review.googleUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-charcoal-500 hover:text-charcoal-950"
                >
                  View on Google
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-3 w-3" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .carousel-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
</style>
