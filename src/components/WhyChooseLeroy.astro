---
import { reasons } from "../data/content";
---

<section class="bg-charcoal-950 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="reveal max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wide text-yellow-500">Why choose Leroy</span>
      <h2 class="mt-3 font-display text-3xl font-semibold text-white sm:text-4xl">
        Lessons built around you, not a script
      </h2>
      <p class="mt-4 text-charcoal-400">
        A calm, tailored approach that's helped learners across Brighton and Hove pass with genuine confidence.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((reason, i) => (
        <div
          class="reveal group rounded-2xl border border-white/10 bg-charcoal-900 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-yellow-500/40"
          style={`animation-delay: ${i * 80}ms`}
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-yellow-500/10 text-yellow-500 transition-colors group-hover:bg-yellow-500 group-hover:text-charcoal-950">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
              <path d="M9 12.5 11 15l4.5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="mt-4 font-display text-lg font-semibold text-white">{reason.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-400">{reason.description}</p>
        </div>
      ))}
    </div>

    <div class="reveal mt-12 text-center">
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-full bg-yellow-500 px-7 py-3.5 text-sm font-semibold text-charcoal-950 shadow-lg shadow-yellow-500/10 transition-transform hover:-translate-y-0.5 hover:bg-yellow-400"
      >
        Start Your Driving Journey
      </a>
    </div>
  </div>
</section>
